<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="32dp">

        <!-- Kopf: Logo links, Kennung rechts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:adjustViewBounds="true"
                android:contentDescription="rittau"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/logoPlaceholder"
                style="@style/Kicker"
                android:text="LOGO · PLATZHALTER"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Kicker"
                android:text="NFC-KARTE" />
        </LinearLayout>

        <View style="@style/Line" />

        <!-- 01/ Visitenkarte -->
        <LinearLayout style="@style/SectionHead">
            <TextView style="@style/KickerNum" android:layout_marginRight="6dp" android:text="01/" />
            <TextView style="@style/Kicker" android:text="Visitenkarte" />
        </LinearLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.045"
            android:lineSpacingMultiplier="0.95"
            android:textColor="@color/ink"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/statement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.03"
            android:lineSpacingMultiplier="1.04"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical" />

        <!-- 02/ Senden -->
        <View
            style="@style/Line"
            android:layout_marginTop="56dp" />

        <LinearLayout style="@style/SectionHead">
            <TextView style="@style/KickerNum" android:layout_marginRight="6dp" android:text="02/" />
            <TextView
                style="@style/Kicker"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Senden" />
            <TextView
                android:id="@+id/chip"
                style="@style/KickerNum"
                android:text="BEREIT" />
        </LinearLayout>

        <ImageView
            android:id="@+id/shape"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/form_kamm" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.03"
            android:lineSpacingMultiplier="1.05"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/nfcSettings"
            style="@style/PillPrimary"
            android:layout_marginTop="20dp"
            android:text="NFC einschalten"
            android:visibility="gone" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="32dp"
            android:text="Was gesendet wird" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modeContact"
                style="@style/Toggle"
                android:text="Kontakt" />

            <TextView
                android:id="@+id/modeLink"
                style="@style/Toggle"
                android:layout_marginLeft="8dp"
                android:text="Link" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hint_bg"
            android:lineSpacingMultiplier="1.45"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/ink_2"
            android:textSize="15sp" />

        <!-- 03/ Daten -->
        <View
            style="@style/Line"
            android:layout_marginTop="56dp" />

        <LinearLayout style="@style/SectionHead">
            <TextView style="@style/KickerNum" android:layout_marginRight="6dp" android:text="03/" />
            <TextView style="@style/Kicker" android:text="Deine Daten" />
        </LinearLayout>

        <TextView
            android:id="@+id/editToggle"
            style="@style/Pill"
            android:layout_marginTop="20dp"
            android:text="Daten bearbeiten" />

        <LinearLayout
            android:id="@+id/editBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/FieldLabel" android:text="Name" />
            <EditText
                android:id="@+id/fName"
                style="@style/Field"
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/FieldLabel" android:text="Rolle" />
            <EditText
                android:id="@+id/fRole"
                style="@style/Field"
                android:inputType="textCapSentences" />

            <TextView style="@style/FieldLabel" android:text="Firma" />
            <EditText
                android:id="@+id/fCompany"
                style="@style/Field"
                android:inputType="text" />

            <TextView style="@style/FieldLabel" android:text="Abteilung" />
            <EditText
                android:id="@+id/fUnit"
                style="@style/Field"
                android:inputType="textCapWords" />

            <TextView style="@style/FieldLabel" android:text="E-Mail" />
            <EditText
                android:id="@+id/fEmail"
                style="@style/Field"
                android:inputType="textEmailAddress" />

            <TextView style="@style/FieldLabel" android:text="Telefon" />
            <EditText
                android:id="@+id/fPhone"
                style="@style/Field"
                android:inputType="phone" />

            <TextView style="@style/FieldLabel" android:text="Website" />
            <EditText
                android:id="@+id/fWeb"
                style="@style/Field"
                android:inputType="textUri" />

            <TextView style="@style/FieldLabel" android:text="Ort" />
            <EditText
                android:id="@+id/fCity"
                style="@style/Field"
                android:inputType="textCapWords" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/save"
                    style="@style/PillPrimary"
                    android:text="Speichern" />

                <TextView
                    android:id="@+id/cancel"
                    style="@style/Pill"
                    android:layout_marginLeft="8dp"
                    android:text="Abbrechen" />
            </LinearLayout>
        </LinearLayout>

        <!-- Update: manueller Check über den Browser -->
        <LinearLayout
            android:id="@+id/updateBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                style="@style/Line"
                android:layout_marginTop="56dp" />

            <LinearLayout style="@style/SectionHead">
                <TextView style="@style/KickerNum" android:layout_marginRight="6dp" android:text="04/" />
                <TextView style="@style/Kicker" android:text="Update" />
            </LinearLayout>

            <TextView
                android:id="@+id/updateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/hint_bg"
                android:lineSpacingMultiplier="1.45"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/ink_2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/updateBtn"
                style="@style/PillPrimary"
                android:layout_marginTop="16dp"
                android:text="Nach Update suchen" />
        </LinearLayout>

        <!-- Fuß -->
        <View
            style="@style/Line"
            android:layout_marginTop="64dp" />

        <TextView
            style="@style/Kicker"
            android:layout_marginTop="12dp"
            android:text="@string/footer"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/version"
            style="@style/Kicker"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
