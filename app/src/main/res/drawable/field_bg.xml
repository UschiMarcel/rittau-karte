<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/field" /></shape></item>
            <item android:gravity="bottom|fill_horizontal" android:height="3dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/field" /></shape></item>
            <item android:gravity="bottom|fill_horizontal" android:height="1dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
